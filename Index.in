<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shanthi Tailors | Thanjavur</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #fffaf5;
            color: #333;
        }

        header {
            background: #702963;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            background: #4b1942;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
        }

        .hero {
            text-align: center;
            padding: 80px 20px;
            background: #f3dce9;
        }

        .hero h2 {
            font-size: 36px;
            color: #702963;
        }

        .hero p {
            margin: 15px;
            font-size: 18px;
        }

        .btn {
            display: inline-block;
            background: #702963;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 15px;
        }

        section {
            padding: 45px 20px;
            text-align: center;
        }

        h2 {
            color: #702963;
            margin-bottom: 20px;
        }

        .services {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .service {
            background: white;
            padding: 25px;
            width: 220px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #ddd;
        }

        .service h3 {
            color: #702963;
            margin-bottom: 10px;
        }

        .contact {
            background: #f3dce9;
        }

        footer {
            background: #4b1942;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>🧵 Shanthi Tailors</h1>
        <p>Perfect Stitching, Perfect Style</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="hero" id="home">
        <h2>Your Style, Our Stitching!</h2>
        <p>Professional Tailoring Services in Thanjavur.</p>
        <a href="#contact" class="btn">Contact Us</a>
    </div>

    <section id="about">
        <h2>About Us</h2>
        <p>
            Welcome to Shanthi Tailors!
            We provide quality stitching and tailoring
            services with care, creativity and perfection.
            Your satisfaction is our priority.
        </p>
    </section>

    <section id="services">
        <h2>Our Services</h2>

        <div class="services">

            <div class="service">
                <h3>👗 Ladies Blouse</h3>
                <p>Beautiful blouse stitching with perfect fitting.</p>
            </div>

            <div class="service">
                <h3>👚 Chudidar</h3>
                <p>Stylish and comfortable chudidar stitching.</p>
            </div>

            <div class="service">
                <h3>✂️ Alterations</h3>
                <p>Professional clothing alterations.</p>
            </div>

            <div class="service">
                <h3>🧵 Custom Stitching</h3>
                <p>Custom designs made to match your style.</p>
            </div>

        </div>
    </section>

    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <p><b>Shop:</b> Shanthi Nandakumar Tailors</p>
        <p><b>Phone:</b> +91 99525 63460</p>
        <p><b>Address:</b> 605, Raja Nagar Road,
        Lakshmi Nagar, Thanjavur, Tamil Nadu 613005.</p>

        <a href="https://wa.me/919952563460"
           class="btn">WhatsApp Us</a>
    </section>

    <footer>
        <p>© 2026 Shanthi Tailors. All Rights Reserved.</p>
        <p>Designed with ❤️</p>
    </footer>

</body>
</html>
